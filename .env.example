HF_TOKEN=replace-with-a-read-token-after-accepting-the-pyannote-model-terms

# Bind directly to this address for local development. In production behind
# Nginx, Gunicorn binds to 127.0.0.1 and the Nginx proxy handles public HTTPS.
SERVER_HOST=0.0.0.0
SERVER_PORT=5000

# Comma-separated exact browser origins. Leave unset for localhost-only CORS.
# Example production value: https://classproject.nexa.website
# ALLOWED_ORIGINS=https://classproject.nexa.website

OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b
OLLAMA_TIMEOUT_SECONDS=300

# Faster-Whisper model used for transcription, run on CPU. "small" transcribes
# Urdu and English-Urdu code-switching badly; "medium" is much more accurate but
# needs roughly 2.5-3 GB of RAM per in-flight job. "large-v3" is more accurate
# again but needs around 4 GB and is considerably slower on CPU.
WHISPER_MODEL=medium
WHISPER_COMPUTE_TYPE=int8

# Optional production overrides (use writable persistent directories):
# UPLOAD_FOLDER=/var/lib/class-notes/uploads
# SPEAKER_PROFILES_PATH=/var/lib/class-notes/data/speaker_profiles.json
# PROCESS_AUDIO_RATE_LIMIT=10
# PROCESS_AUDIO_RATE_WINDOW_SECONDS=60

# Processed audio is deleted as soon as a job finishes. Set this to true to keep
# it so a recording can be transcribed again with a different model; files older
# than UPLOAD_RETENTION_DAYS are then swept on the next upload. Recordings are
# sensitive, so this defaults to false.
# KEEP_UPLOADED_AUDIO=false
# UPLOAD_RETENTION_DAYS=7
